# Copy to `.env` for local overrides. `.env` is ignored by Git. Never commit real secrets.
# All values below are optional; the defaults are shown.
FRAUD_RISK_ENVIRONMENT=development
FRAUD_RISK_LOG_LEVEL=INFO
FRAUD_RISK_LOG_FORMAT=json
FRAUD_RISK_RANDOM_SEED=42
FRAUD_RISK_DATA_DIR=data
FRAUD_RISK_ARTIFACTS_DIR=artifacts
FRAUD_RISK_REPORTS_DIR=reports
FRAUD_RISK_DATASET_PATH=data/raw/creditcard.csv
FRAUD_RISK_TRACKING_ENABLED=false
# FRAUD_RISK_TRACKING_URI=sqlite:///artifacts/mlflow/mlflow.db  (default when enabled)
# Inference API. Without FRAUD_RISK_MODEL_BUNDLE_PATH the API serves the registry's *approved*
# model; with neither, /ready reports not-ready (503).
# FRAUD_RISK_MODEL_BUNDLE_PATH=artifacts/models/<model_id>
FRAUD_RISK_RISK_POLICY_PATH=configs/risk_policy.example.json
# FRAUD_RISK_API_KEY=<set a long random value to require the X-API-Key header>
FRAUD_RISK_API_MAX_BATCH_SIZE=500
